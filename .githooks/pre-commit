#!/bin/sh
# TRAVA DE COMMIT DO APP — barra index.html que nao parseia OU que perdeu capacidade.
#
# POR QUE EXISTE (2026-08-18): publiquei o app com uma aspa mal escapada; o script inteiro
# morreu e o app ficou no ar sem funcionar. A checagem que pegaria isso JA existia dentro do
# publicar.sh — eu commitei na mao e passei por fora dela.
# MEDIDO no proprio historico (janela 12/08 a 19/08, commits que tocaram index.html):
# 17 commits, 7 pelo trilho do publicar.sh, 10 por fora. O desvio e o caminho PADRAO, nao a
# excecao. [Numero corrigido em 2026-08-20: a versao anterior dizia "10 de 12" e nao
# reproduzia — o numerador estava certo, o denominador nao. Reproduzir:
#   git log --since=2026-08-12 --until=2026-08-19 --format='%s' -- index.html | wc -l
#   ...mesma lista | grep -cE '\(v [0-9]{2}/[0-9]{2} [0-9]{2}h[0-9]{2}\)$' ]
#
# EM 2026-08-20 ela passou a conferir tambem CAPACIDADE, nao so sintaxe: um commit escrito
# sobre copia antiga do index.html apagou 3 blocos inteiros e o JS continuou parseando.
# As regras moram em checks-app.js (fonte canonica); este arquivo so o chama.
#
# DESENHO (skill 25): detector de ESTADO determinado — o app faz o que tem que fazer, ou nao.
# FAIL-OPEN quanto ao AMBIENTE: sem node, ou sem o checks-app.js, o commit PASSA com aviso
# (a trava nunca vira o motivo de voce nao conseguir salvar trabalho).
# FAIL-CLOSED quanto ao CONTEUDO: se o checks-app.js rodar e reprovar, o commit para.
# ESCAPE: git commit --no-verify  (ou apague este arquivo).
set -e
MUDOU=$(git diff --cached --name-only | grep -xE 'index.html|checks-app.js|checks-suite.py' || true)
[ -n "$MUDOU" ] || exit 0
command -v node >/dev/null 2>&1 || { echo "[pre-commit] node ausente — sem conferir o app (passando)"; exit 0; }
[ -f checks-app.js ] || { echo "[pre-commit] checks-app.js ausente — sem conferir o app (passando)"; exit 0; }

# Confere o index.html COMO ELE VAI FICAR APOS O COMMIT — que e sempre a versao do INDICE:
# se o commit toca o index.html, o indice tem a versao nova; se toca so o checks-app.js, o
# indice tem a versao do HEAD, que continua sendo a que o app serve. Nos dois casos e o
# arquivo certo pra conferir. [Corrigido em 2026-08-20: a versao anterior tinha um ramo
# "senao confere o do disco" que NUNCA rodava — `git show :index.html` sempre tem sucesso
# pra arquivo rastreado, esteja ou nao staged. Comentario que descreve caminho morto engana
# quem for mexer depois.]
TMP=$(mktemp 2>/dev/null || echo "/tmp/precommit-index.html")
git show :index.html > "$TMP" 2>/dev/null || { echo "[pre-commit] index.html fora do indice — nada a conferir"; exit 0; }
# REDE GROSSA: compara com a versao ANTERIOR (HEAD) e barra se alguma funcao sumiu sem
# declaracao. E o unico check que nao depende de alguem ter lembrado de enumerar a capacidade,
# e por isso e o que de fato cobre "commit escrito sobre copia antiga do arquivo".
# Remocao proposital:  PODE_REMOVER="nomeA,nomeB" git commit ...   (ou PODE_REMOVER=tudo)
BASE=$(mktemp 2>/dev/null || echo "/tmp/precommit-base.html")
if git show HEAD:index.html > "$BASE" 2>/dev/null; then
  node checks-app.js "$TMP" --contra "$BASE" || { rm -f "$TMP" "$BASE"; exit 1; }
else
  node checks-app.js "$TMP" || { rm -f "$TMP"; exit 1; }
fi
rm -f "$BASE"
rm -f "$TMP"
