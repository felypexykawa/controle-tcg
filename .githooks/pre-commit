#!/bin/sh
# TRAVA DE COMMIT DO APP — barra index.html que nao parseia OU que perdeu capacidade.
#
# POR QUE EXISTE (2026-08-18): publiquei o app com uma aspa mal escapada; o script inteiro
# morreu e o app ficou no ar sem funcionar. A checagem que pegaria isso JA existia dentro do
# publicar.sh — eu commitei na mao e passei por fora dela.
# MEDIDO no proprio historico (janela 12/08 a 19/08, commits que tocaram index.html):
# 17 commits, 7 pelo trilho do publicar.sh, 10 por fora. O desvio e o caminho PADRAO, nao a
# excecao. [Numero corrigido em 2026-08-20: a versao anterior dizia "10 de 12" e nao
# reproduzia — o numerador estava certo, o denominador nao. Reproduzir:
#   git log --since=2026-08-12 --until=2026-08-19 --format='%s' -- index.html | wc -l
#   ...mesma lista | grep -cE '\(v [0-9]{2}/[0-9]{2} [0-9]{2}h[0-9]{2}\)$' ]
#
# EM 2026-08-20 ela passou a conferir tambem CAPACIDADE, nao so sintaxe: um commit escrito
# sobre copia antiga do index.html apagou 3 blocos inteiros e o JS continuou parseando.
# As regras moram em checks-app.js (fonte canonica); este arquivo so o chama.
#
# DESENHO (skill 25): detector de ESTADO determinado — o app faz o que tem que fazer, ou nao.
# FAIL-OPEN quanto ao AMBIENTE: sem node, ou sem o checks-app.js no repositorio (nem neste commit nem no HEAD), o commit PASSA com aviso
# (a trava nunca vira o motivo de voce nao conseguir salvar trabalho). Tirar do commit uma peca que o HEAD tem (git rm, git mv) BARRA.
# FAIL-CLOSED quanto ao CONTEUDO: se o checks-app.js rodar e reprovar, o commit para.
# ESCAPE: git commit --no-verify  (ou apague este arquivo).
set -e
# [v2.6e, revisor fiacao r8 M1] Ctrl+C dentro do hook saia mudo e deixava a copia do index.html e a pasta das pecas no TEMP (perto de 1 MB)
TMP=""; BASE=""; PECAS=""; TP=""; TC=""
# [v2.6f, revisor fiacao r9 L1] temporarios com prefixo fixo e faxina no comeco: com a tecla de verdade o git cai no meio e leva o hook junto, e
# pelo publicar.sh com o terminal aberto nada era limpo em 7 de 8 interrupcoes (cerca de 1,8 MB por Ctrl+C); o hook seguinte, pelo publicar.sh
# ou a mao, apaga os que tem mais de 10 minutos
TMPD=${TMPDIR:-/tmp}
tmpf() { mktemp "$TMPD/tcg-precommit.XXXXXX" 2>/dev/null || echo "$TMPD/tcg-precommit.$$.$1"; }
tmpd() { mktemp -d "$TMPD/tcg-precommit.XXXXXX" 2>/dev/null || { mkdir -p "$TMPD/tcg-precommit.$$.pecas"; echo "$TMPD/tcg-precommit.$$.pecas"; }; }
find "$TMPD" -maxdepth 1 -name 'tcg-precommit.*' -mmin +10 -exec rm -rf {} + 2>/dev/null || true
limpa() { for f in "$TMP" "$BASE" "$PECAS" "$TP" "$TC"; do [ -n "$f" ] && rm -rf "$f"; done; return 0; }
trap 'limpa; echo "[pre-commit] interrompido: nada foi commitado"; exit 130' INT TERM
# [v2.6e, revisor fiacao r8 L1] --no-renames: com a deteccao de renomeacao, `git mv checks-app.js outro.js` so mostrava o nome novo, o filtro
# nao via a peca saindo e o hook saia antes da cura
MUDOU=$(git diff --cached --no-renames --name-only | grep -xE 'index.html|checks-app.js|checks-suite.py|testes-nucleo.js|testes-nucleo.minimo|trava-nucleo.sh' || true)

# TRAVA DO DADO DE PRECO (2026-08-21). O filtro acima so olha o CODIGO do app; o precos.json,
# que e o dado que o Felype de fato le na tela, nao era conferido por nada — commit que mexia
# so nele passava por zero trava. Foi assim que "Vaporeon (tg02-tg30)" perdeu o preco de
# R$200,00 em silencio: o robo renomeou a ficha e a linha do cadastro ficou orfa.
# Confere a versao do INDICE, nao a do disco — e o que vai ser commitado de verdade.
DADO=$(git diff --cached --no-renames --name-only | grep -xE 'precos.json|robo/codigos.txt' || true)
if [ -n "$DADO" ]; then
  if ! command -v node >/dev/null 2>&1 || [ ! -f robo/check-fichas-rachadas.js ]; then
    echo "[pre-commit] node ou check-fichas-rachadas.js ausente — sem conferir o dado de preco (passando)"
  else
    TP=$(tmpf precos)
    TC=$(tmpf codigos)
    git show :precos.json      > "$TP" 2>/dev/null || git show HEAD:precos.json      > "$TP" 2>/dev/null || true
    git show :robo/codigos.txt > "$TC" 2>/dev/null || git show HEAD:robo/codigos.txt > "$TC" 2>/dev/null || true
    PRECOS_JSON="$TP" CODIGOS_TXT="$TC" node robo/check-fichas-rachadas.js || { rm -f "$TP" "$TC"; exit 1; }
    rm -f "$TP" "$TC"
  fi
fi

[ -n "$MUDOU" ] || exit 0
command -v node >/dev/null 2>&1 || { echo "[pre-commit] node ausente — sem conferir o app (passando)"; exit 0; }
# [v2.6d, revisor fiacao r7 L1] "ausente" so e ambiente quando o HEAD tambem nao tem a peca: `git rm checks-app.js` saia por aqui, antes do laco
# que barra as pecas, e o commit passava sem --no-verify. [v2.6e, revisor fiacao r8 L1] a peca no INDICE, nao no disco: apagar so do disco
# barrava com motivo falso, e o commit levava a peca do mesmo jeito
if ! git cat-file -e :checks-app.js 2>/dev/null; then
  if git cat-file -e HEAD:checks-app.js 2>/dev/null; then
    echo "COMMIT BARRADO: checks-app.js sai do repositorio neste commit — rode: git checkout HEAD -- checks-app.js e git add checks-app.js. Tirar de proposito e decisao consciente: git commit --no-verify passa daqui, e o CI reprova"; exit 1
  fi
  echo "[pre-commit] checks-app.js ausente — sem conferir o app (passando)"; exit 0
fi

# Confere o index.html COMO ELE VAI FICAR APOS O COMMIT — que e sempre a versao do INDICE:
# se o commit toca o index.html, o indice tem a versao nova; se toca so o checks-app.js, o
# indice tem a versao do HEAD, que continua sendo a que o app serve. Nos dois casos e o
# arquivo certo pra conferir. [Corrigido em 2026-08-20: a versao anterior tinha um ramo
# "senao confere o do disco" que NUNCA rodava — `git show :index.html` sempre tem sucesso
# pra arquivo rastreado, esteja ou nao staged. Comentario que descreve caminho morto engana
# quem for mexer depois.]
TMP=$(tmpf index)
git show :index.html > "$TMP" 2>/dev/null || { echo "[pre-commit] index.html fora do indice — nada a conferir"; exit 0; }
# REDE GROSSA: compara com a versao ANTERIOR (HEAD) e barra se alguma funcao sumiu sem
# declaracao. E o unico check que nao depende de alguem ter lembrado de enumerar a capacidade,
# e por isso e o que de fato cobre "commit escrito sobre copia antiga do arquivo".
# Remocao proposital:  PODE_REMOVER="nomeA,nomeB" git commit -m "msg" -m "PODE_REMOVER=nomeA,nomeB"
# (a variavel libera AQUI; a linha na MENSAGEM libera no CI, que nao ve ambiente. Publicando
#  por `PODE_REMOVER=... sh publicar.sh`, o carimbo na mensagem sai sozinho.)
# [13/09, revisor fiacao r2 M6] cada peca na versao do INDICE, nao a do disco: o app ja vinha do indice, mas o checks-app.js, o
# testes-nucleo.js e o minimo vinham do disco — o commit era certificado com uma combinacao que nao era a dele (visto: commit
# barrado mostrando so "checks do app OK", porque a secao nova do disco estourava contra o app velho do indice).
# [13/09, revisor fiacao r3 M2] sem reserva do disco: ela so era alcancada quando a peca NAO ia no commit (git rm --cached,
# commit -am com a peca nova ainda nao adicionada) — ou seja, certificava justamente a combinacao errada, e o CI ficava
# vermelho depois. Peca fora do indice barra o commit dizendo o que adicionar.
PECAS=$(tmpd)

doIndice() { if git show ":$1" > "$PECAS/$1" 2>/dev/null; then echo "$PECAS/$1"; fi; }
# [v2.6, revisor fiacao r5 L4] a suite da vacina tambem tem de estar no commit: apagada, o publicar.sh seguia sem ela e so o CI via, depois do push
CHECKS=$(doIndice checks-app.js); TESTES=$(doIndice testes-nucleo.js); MINIMO=$(doIndice testes-nucleo.minimo); TRAVA=$(doIndice trava-nucleo.sh); SUITE=$(doIndice checks-suite.py)
for par in "checks-app.js:$CHECKS" "testes-nucleo.js:$TESTES" "testes-nucleo.minimo:$MINIMO" "trava-nucleo.sh:$TRAVA" "checks-suite.py:$SUITE"; do
  # [v2.6c, revisor fiacao r6 L4] quem barra a peca fora do commit e este hook (a nota SEM-SUITE do publicar.sh so chega ao commit quando o
  # proprio hook tambem sumiu); a saida consciente fica dita na mensagem
  [ -n "${par#*:}" ] || { echo "COMMIT BARRADO: ${par%%:*} nao esta neste commit (removido ou ainda nao adicionado) — rode: git add ${par%%:*}. Tirar de proposito e decisao consciente: git commit --no-verify passa daqui, e o CI reprova"; limpa; exit 1; }
done
BASE=$(tmpf base)
if git show HEAD:index.html > "$BASE" 2>/dev/null; then
  node "$CHECKS" "$TMP" --contra "$BASE" || { limpa; exit 1; }
else
  node "$CHECKS" "$TMP" || { limpa; exit 1; }
fi
# regras de negocio de ponta a ponta, sobre a MESMA versao do indice que a vacina acabou de ver. [fotos F1 23/08, P0-5] portao
# fail-closed; [13/09, M1] a regra mora em trava-nucleo.sh, a mesma do publicar.sh e do CI (a copia antiga saia muda com set -e)
sh "$TRAVA" "$TMP" "$TESTES" "$MINIMO" || { echo "COMMIT BARRADO (o motivo esta acima)"; limpa; exit 1; }
limpa
